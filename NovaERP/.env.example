# NovaERP Frontend Environment Variables (Example)
# Copy this file to .env and fill in the values

# API Base URL — used by Axios client
# Leave empty to use Vite proxy (recommended for development)
VITE_API_BASE_URL=/api

# Google OAuth 2.0 Client ID
# Get this from Google Cloud Console → APIs & Services → Credentials
# Create a Web Application OAuth 2.0 Client ID
# Set Authorized JavaScript Origins to: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
